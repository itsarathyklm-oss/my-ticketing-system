# multer-storage-cloudinary@4.0.0 (unmaintained, 2020) still declares
# peerDependencies { "cloudinary": "^1.21.0" }, but this project runs the
# cloudinary 2.x SDK. The uploader interface that package uses
# (uploader.upload_stream(options, callback)) is unchanged in 2.x and the
# upload path has been verified against it, so let npm resolve the install
# instead of failing the build on that stale peer range.
legacy-peer-deps=true
