# Environment template for Sarathy IT Helpdesk.
# Copy to .env and fill in every value. NEVER commit the real .env (it is gitignored).
# See README.md "Environment variables" for what each key does.

# --- Server ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=

# --- Super Admin account (the env-var admin, not a database row) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=helpdesk
MYSQL_USER=root
MYSQL_PASSWORD=
# Managed MySQL (Aiven, Render, etc.) requires TLS — set MYSQL_SSL=1 and point
# MYSQL_CA_FILE at the service's CA certificate for strict verification.
# Leave both empty for a local XAMPP/Workbench MySQL (no TLS).
MYSQL_SSL=
MYSQL_CA_FILE=

# --- Cloudinary (screenshot/attachment storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SMTP (optional; app boots without it and logs a mailer warning) ---
EMAIL_USER=
EMAIL_PASS=

# --- Logging (optional; leave empty to default to ./logs) ---
LOG_DIR=
